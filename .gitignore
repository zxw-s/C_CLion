*.o
*.obj
*.exe
*.out
*.dll
*.so
*.a
*.lib
*.elf
*.hex
*.bin
*.dylib
# 编译中间文件
*.i
*.s
# 调试文件
*.pdb
*.map
# CMake
CMakeCache.txt
CMakeFiles/
cmake-build-*/
